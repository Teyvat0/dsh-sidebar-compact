{
  "name": "dsh-sidebar-compact",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Compact, collapse-friendly left sidebar for the DeepSeek Harness Web UI.",
  "license": "MIT",
  "author": "Teyvat0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "ui"
  ],
  "homepage": "https://github.com/Teyvat0/dsh-sidebar-compact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyvat0/dsh-sidebar-compact.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
